rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateKey(dateKey) {
      return dateKey is string && dateKey.size() == 10 && dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    function isValidUser(data, userId) {
      return data.keys().hasAll([
        'uid', 'displayName', 'email', 'dailyGoal', 'heightCm', 'weightKg',
        'strideLengthCm', 'unitSystem', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid', 'displayName', 'email', 'photoURL', 'dailyGoal', 'heightCm',
        'weightKg', 'strideLengthCm', 'unitSystem', 'createdAt', 'updatedAt'
      ])
      && data.uid is string
      && data.uid.size() >= 1 && data.uid.size() <= 128
      && data.uid == request.auth.uid
      && data.uid == userId
      && data.displayName is string
      && data.displayName.size() >= 1 && data.displayName.size() <= 80
      && data.email is string
      && data.email.size() >= 3 && data.email.size() <= 160
      && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
      && data.dailyGoal is number
      && data.dailyGoal >= 1000 && data.dailyGoal <= 100000
      && data.heightCm is number
      && data.heightCm >= 100 && data.heightCm <= 250
      && data.weightKg is number
      && data.weightKg >= 30 && data.weightKg <= 250
      && data.strideLengthCm is number
      && data.strideLengthCm >= 30 && data.strideLengthCm <= 150
      && data.unitSystem in ['metric', 'imperial']
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidDailyStep(data, userId, dateKey) {
      return data.keys().hasAll([
        'uid', 'date', 'steps', 'goal', 'distanceMeters', 'calories',
        'activeMinutes', 'flightsClimbed', 'hourlySteps', 'source',
        'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid', 'date', 'steps', 'goal', 'distanceMeters', 'calories',
        'activeMinutes', 'flightsClimbed', 'hourlySteps', 'source',
        'createdAt', 'updatedAt'
      ])
      && data.uid is string
      && data.uid.size() >= 1 && data.uid.size() <= 128
      && data.uid == request.auth.uid
      && data.uid == userId
      && isValidDateKey(data.date)
      && data.date == dateKey
      && data.steps is number
      && data.steps >= 0 && data.steps <= 250000
      && data.goal is number
      && data.goal >= 1000 && data.goal <= 100000
      && data.distanceMeters is number
      && data.distanceMeters >= 0 && data.distanceMeters <= 300000
      && data.calories is number
      && data.calories >= 0 && data.calories <= 20000
      && data.activeMinutes is number
      && data.activeMinutes >= 0 && data.activeMinutes <= 1440
      && data.flightsClimbed is number
      && data.flightsClimbed >= 0 && data.flightsClimbed <= 500
      && data.hourlySteps is list
      && data.hourlySteps.size() == 24
      && data.hourlySteps[0] is number
      && data.hourlySteps[0] >= 0
      && data.hourlySteps[23] is number
      && data.hourlySteps[23] >= 0
      && data.source in ['sensor', 'manual', 'import', 'hybrid']
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidStepSession(data, userId) {
      return data.keys().hasAll([
        'uid', 'date', 'steps', 'durationSeconds', 'distanceMeters',
        'calories', 'avgCadenceSpm', 'source', 'note', 'createdAt'
      ])
      && data.keys().hasOnly([
        'uid', 'date', 'steps', 'durationSeconds', 'distanceMeters',
        'calories', 'avgCadenceSpm', 'source', 'note', 'createdAt'
      ])
      && data.uid is string
      && data.uid.size() >= 1 && data.uid.size() <= 128
      && data.uid == request.auth.uid
      && data.uid == userId
      && isValidDateKey(data.date)
      && data.steps is number
      && data.steps >= 1 && data.steps <= 200000
      && data.durationSeconds is number
      && data.durationSeconds >= 0 && data.durationSeconds <= 86400
      && data.distanceMeters is number
      && data.distanceMeters >= 0 && data.distanceMeters <= 300000
      && data.calories is number
      && data.calories >= 0 && data.calories <= 20000
      && data.avgCadenceSpm is number
      && data.avgCadenceSpm >= 0 && data.avgCadenceSpm <= 300
      && data.source in ['pedometer', 'manual', 'apple_health_import']
      && data.note is string
      && data.note.size() <= 140
      && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUser(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUser(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'dailyGoal', 'heightCm',
          'weightKg', 'strideLengthCm', 'unitSystem', 'updatedAt'
        ]);
      allow delete: if false;

      match /dailySteps/{dateKey} {
        allow get: if isValidId(userId) && isValidDateKey(dateKey) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidDateKey(dateKey)
          && isOwner(userId)
          && isValidDailyStep(incoming(), userId, dateKey)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId)
          && isValidDateKey(dateKey)
          && isOwner(userId)
          && isValidDailyStep(incoming(), userId, dateKey)
          && incoming().uid == existing().uid
          && incoming().date == existing().date
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'steps', 'goal', 'distanceMeters', 'calories', 'activeMinutes',
            'flightsClimbed', 'hourlySteps', 'source', 'updatedAt'
          ])
          && exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isValidId(userId) && isValidDateKey(dateKey) && isOwner(userId);
      }

      match /stepSessions/{sessionId} {
        allow get: if isValidId(userId) && isValidId(sessionId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(sessionId)
          && isOwner(userId)
          && isValidStepSession(incoming(), userId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(sessionId) && isOwner(userId);
      }
    }
  }
}
